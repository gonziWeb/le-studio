# Le Studio
Options -Indexes
DirectoryIndex index.html

# Toujours en https (nécessaire pour le micro)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Interdire l'accès direct au dossier de secours des données et aux fichiers cachés
RedirectMatch 404 ^/(.*/)?data(/|$)
RedirectMatch 404 /\.(git|user\.ini|ovhconfig)
